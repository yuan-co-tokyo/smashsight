{
  "name": "smashsight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "auth:schema": "node --env-file=.env.local node_modules/auth/dist/index.mjs generate --config ./lib/auth.ts --output ./lib/db/schema/auth.ts --yes",
    "pose:sync-assets": "node scripts/sync-pose-assets.mjs",
    "predev": "pnpm pose:sync-assets",
    "prebuild": "pnpm pose:sync-assets"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "better-auth": "^1.6.27",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3",
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-presigned-post": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "drizzle-kit": "^0.31.10",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10",
    "auth": "^1.6.27",
    "@mediapipe/tasks-vision": "1.0.1"
  }
}

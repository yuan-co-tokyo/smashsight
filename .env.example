# Neon（シンガポール） の PostgreSQL 接続URL（DBユーザー・パスワードを含む）。
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
# セッション署名用のランダムな秘密値。openssl rand -base64 32 などで生成。
BETTER_AUTH_SECRET=
# アプリの公開URL。本番では実際の HTTPS URL に変更する。
BETTER_AUTH_URL=http://localhost:3000
# 登録時に必要な招待コード。未設定・空の場合は新規登録をすべて拒否。
INVITE_CODE=
# S3 のリージョン。AWSではソウルを使用。
AWS_REGION=ap-northeast-2
# パブリックアクセスをブロックした動画保存用バケット。
S3_BUCKET_NAME=
# ローカル開発用IAM認証情報。SDK既定の認証チェーンを使用。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 任意: LocalStack等のS3互換ストレージ。ブラウザからも到達できるURLを指定。
S3_ENDPOINT=
# LocalStackでは true。通常のAWS S3では false。
S3_FORCE_PATH_STYLE=false
